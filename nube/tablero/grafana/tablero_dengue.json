    {
      "id": 11,
      "type": "stat",
      "title": "Desempeño en semanas cerradas",
      "description": "Semanas-departamento fuera del entrenamiento con desenlace observado. Recall = VP / (VP + FN); precisión = VP / (VP + FP). Vacío en años que el modelo usó para entrenar.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "${DS_ATHENA}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${DS_ATHENA}"
          },
          "format": 1,
          "rawSQL": "SELECT sum(semanas) AS \"Observaciones\",\n       sum(aciertos) AS \"VP\", sum(falsas_alarmas) AS \"FP\",\n       sum(brotes_no_detectados) AS \"FN\",\n       sum(semanas) - sum(aciertos) - sum(falsas_alarmas) - sum(brotes_no_detectados) AS \"VN\",\n       CAST(sum(aciertos) AS double) / NULLIF(sum(brotes), 0) AS \"Recall\",\n       CAST(sum(aciertos) AS double) / NULLIF(sum(alertas), 0) AS \"Precisión\"\nFROM minsadengue_gold.v_desempeno_alertas\nWHERE ano = ${ano} AND subconjunto = '${evaluacion}' AND NOT dentro_entrenamiento",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Recall"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Precisión"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      }
