    {
      "id": 6,
      "type": "table",
      "title": "Ranking de riesgo en la semana de corte",
      "description": "Departamentos ordenados por el puntaje del modelo. El puntaje viene de una regresión logística ponderada: ordena el riesgo, pero no es una probabilidad calibrada.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "${DS_ATHENA}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${DS_ATHENA}"
          },
          "format": 1,
          "rawSQL": "SELECT puesto AS \"Puesto\", departamento AS \"Departamento\",\n       probabilidad AS \"Puntaje\",\n       CASE WHEN alerta THEN 'Sí' ELSE 'No' END AS \"Alerta\",\n       CASE WHEN brote_actual = 1 THEN 'Sí' ELSE 'No' END AS \"Brote vigente\",\n       casos AS \"Casos\", umbral_q3 AS \"Umbral Q3\"\nFROM minsadengue_gold.v_ranking_riesgo\nWHERE ano = ${ano} AND semana = (SELECT max(semana) FROM minsadengue_gold.v_ranking_riesgo WHERE ano = ${ano})\n  AND departamento IN (${departamento:singlequote})\nORDER BY puesto",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Puntaje"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-YlRd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Umbral Q3"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alerta"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Sí": {
                        "color": "orange",
                        "index": 0
                      },
                      "No": {
                        "color": "transparent",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Brote vigente"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Sí": {
                        "color": "red",
                        "index": 0
                      },
                      "No": {
                        "color": "transparent",
                        "index": 1
                      }
                    }
