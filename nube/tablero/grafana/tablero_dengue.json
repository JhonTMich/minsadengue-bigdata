    {
      "id": 12,
      "type": "barchart",
      "title": "Recall y precisión por mes",
      "description": "Calculados con los conteos de cada mes, no promediando porcentajes.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "${DS_ATHENA}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${DS_ATHENA}"
          },
          "format": 1,
          "rawSQL": "SELECT element_at(ARRAY['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Set','Oct','Nov','Dic'], m) AS \"Mes\", recall AS \"Recall\", precision AS \"Precisión\"\nFROM (SELECT mes AS m,\n             CAST(sum(aciertos) AS double) / NULLIF(sum(brotes), 0) AS recall,\n             CAST(sum(aciertos) AS double) / NULLIF(sum(alertas), 0) AS precision\n      FROM minsadengue_gold.v_desempeno_alertas\n      WHERE ano = ${ano} AND subconjunto = '${evaluacion}' AND NOT dentro_entrenamiento\n      GROUP BY mes)\nORDER BY m",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          }
        }
      ],
      "options": {
        "xField": "Mes",
        "orientation": "vertical",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Recall"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Precisión"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      }
    }
  ]
