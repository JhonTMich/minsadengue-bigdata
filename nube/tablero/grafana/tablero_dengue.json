            "uid": "${DS_ATHENA}"
          },
          "format": 1,
          "rawSQL": "SELECT ano AS \"Año\", max(semana) AS \"Semana de corte\"\nFROM minsadengue_gold.v_ranking_riesgo WHERE ano = ${ano} GROUP BY ano",
          "connectionArgs": {
