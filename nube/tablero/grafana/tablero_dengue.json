      "id": 8,
      "type": "trend",
      "title": "Casos y umbral Q3 por semana",
      "description": "Suma de los departamentos elegidos. Con varios departamentos, la línea Q3 es la suma de sus umbrales, no un canal nacional.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "${DS_ATHENA}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${DS_ATHENA}"
          },
          "format": 1,
          "rawSQL": "SELECT semana, sum(casos) AS \"Casos\", sum(umbral_q3) AS \"Umbral Q3\"\nFROM minsadengue_gold.v_casos_vs_canal\nWHERE ano = ${ano} AND departamento IN (${departamento:singlequote})\nGROUP BY semana ORDER BY semana",
          "connectionArgs": {
