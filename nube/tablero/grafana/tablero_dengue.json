          "rawSQL": "SELECT departamentos_en_alerta AS \"En alerta\",\n       departamentos_en_brote AS \"En brote\",\n       departamentos_evaluados AS \"Evaluados\"\nFROM minsadengue_gold.v_departamentos_en_alerta\nWHERE ano = ${ano} AND semana = (SELECT max(semana) FROM minsadengue_gold.v_ranking_riesgo WHERE ano = ${ano})",
