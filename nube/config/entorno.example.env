AWS_REGION=us-east-1
# ID de la cuenta propia (12 dígitos, no es una credencial).
EXPECTED_ACCOUNT_ID=
BUCKET=
# Referencia Spark 3.5.0; verificar disponibilidad y cuotas de la cuenta.
EMR_RELEASE=emr-7.1.0
INSTANCIA=m5.xlarge
# Un primario + un core = dos nodos en total.
NODOS_CORE=1
ROL_SERVICIO_EMR=MinsaDengueEMRService
PERFIL_INSTANCIA_EMR=MinsaDengueEMREC2
# preparar crea una subred dedicada y escribe una configuración con su ID.
SUBNET_ID=
IDLE_TIMEOUT=900
SHUFFLE_PARTITIONS=8
GLUE_DATABASE=